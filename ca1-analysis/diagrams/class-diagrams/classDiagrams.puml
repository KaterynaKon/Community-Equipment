@startuml
title DCD: UC-01 Record Loan Request

top to bottom direction

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

' Only the classes and operations used by UC-01 Record Loan Request.
' Classes for assessment, collection and return belong to later use cases
' and are not part of this design.

' =====================================================
' 1. APPLICATION LAYER
' =====================================================

package "Application Layer" {

  class LoanRequestController <<controller>> {
    + startLoanRequest(): void
    + recordBorrower(name: String, borrowerCategory: String [0..1], contactDetails: String): void
    + addRequestedEquipment(equipmentType: EquipmentType, quantity: int): void
    + setRequestDates(collectionDate: LocalDate [0..1], returnDate: LocalDate [0..1]): void
    + saveLoanRequest(): RecordingResult
  }

  class LoanRequestService {
    - currentRequestData: LoanRequestDTO [0..1]

    + startLoanRequest(): void
    + recordBorrower(name: String, borrowerCategory: String [0..1], contactDetails: String): void
    + addRequestedEquipment(equipmentType: EquipmentType, quantity: int): void
    + setRequestDates(collectionDate: LocalDate [0..1], returnDate: LocalDate [0..1]): void
    + saveLoanRequest(): RecordingResult
  }
}

' =====================================================
' 2. DATA TRANSFER OBJECTS AND RESULTS
' =====================================================

package "Data Transfer Objects and Results" {

  class LoanRequestDTO <<data>> {
    - borrowerName: String [0..1]
    - borrowerCategory: String [0..1]
    - contactDetails: String [0..1]
    - collectionDate: LocalDate [0..1]
    - returnDate: LocalDate [0..1]
  }

  class RequestedEquipmentLineDTO <<data>> {
    - equipmentType: EquipmentType
    - quantity: int
  }

  class RecordingResult <<result>> {
    - success: boolean
    - request: LoanRequest [0..1]
    - errorMessage: String [0..1]
  }
}

' =====================================================
' 3. DOMAIN MODEL
' =====================================================

package "Domain Model" {

  class Borrower <<entity>> {
    - borrowerId: int
    - name: String
    - contactDetails: String
    - borrowerCategory: String [0..1]

    + Borrower(name: String, borrowerCategory: String [0..1], contactDetails: String)
  }

  class LoanRequest <<entity>> {
    - requestId: int
    - receivedDate: LocalDate
    - collectionDate: LocalDate [0..1]
    - returnDate: LocalDate [0..1]
    - status: RequestStatus

    + LoanRequest(borrower: Borrower, collectionDate: LocalDate [0..1], returnDate: LocalDate [0..1])
    + addRequestedEquipment(equipmentType: EquipmentType, quantity: int): RequestedEquipmentLine
    + isCompleteForAssessment(): boolean
    + markRecorded(): void
  }

  class RequestedEquipmentLine <<entity>> {
    - lineId: int
    - requestedQuantity: int
  }

  class EquipmentType <<entity>> {
    - equipmentTypeId: int
    - name: String
  }

  enum RequestStatus {
    AwaitingAssessment
    AwaitingInformation
  }
}

' =====================================================
' 4. REPOSITORY LAYER
' =====================================================

package "Repository Layer" {

  interface LoanRequestRepository {
    + save(request: LoanRequest): void
  }

  interface BorrowerRepository {
    + findByDetails(name: String, borrowerCategory: String [0..1], contactDetails: String): Borrower [0..1]
  }

  class LoanRequestRepositoryImpl
  class BorrowerRepositoryImpl
}

' =====================================================
' 5. RELATIONSHIPS
' =====================================================

' Domain associations
Borrower "1" -- "0..*" LoanRequest : makes
LoanRequest "1" *-- "1..*" RequestedEquipmentLine : contains
RequestedEquipmentLine "0..*" --> "1" EquipmentType : requests
LoanRequest --> RequestStatus

' Temporary context held until saveLoanRequest()
LoanRequestService "1" -- "0..1" LoanRequestDTO : holds current data
LoanRequestDTO "1" *-- "0..*" RequestedEquipmentLineDTO : equipmentLines
RequestedEquipmentLineDTO --> EquipmentType

' Controller and service dependencies
LoanRequestController ..> LoanRequestService : delegates
LoanRequestService ..> LoanRequest : <<create>>
LoanRequestService ..> Borrower : <<create>> for a new borrower
LoanRequestService ..> RecordingResult : <<create>>
LoanRequestService ..> LoanRequestRepository : saves requests
LoanRequestService ..> BorrowerRepository : finds borrowers
LoanRequest ..> RequestedEquipmentLine : <<create>>
RecordingResult --> LoanRequest

' Interface realisation
LoanRequestRepositoryImpl ..|> LoanRequestRepository
BorrowerRepositoryImpl ..|> BorrowerRepository

@enduml
